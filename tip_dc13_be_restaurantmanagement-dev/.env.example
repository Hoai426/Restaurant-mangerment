# ===== BAT BUOC =====
# MySQL 8+, vi du: jdbc:mysql://localhost:3306/restaurant_management?serverTimezone=UTC
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Toi thieu 32 ky tu (256-bit) cho HS256. Sinh bang: openssl rand -base64 48
JWT_SECRET=

# --- Email ---
# Local (Gmail): MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_PASSWORD=App Password
# Render Free (chan 25/465/587): dung Brevo
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=2525
#   MAIL_USERNAME=<SMTP login tren Brevo>
#   MAIL_PASSWORD=<SMTP key, KHONG phai API key>
#   MAIL_FROM=<email da xac minh tren Brevo>
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Tai khoan ADMIN khoi tao lan dau (chi tao neu chua co ADMIN)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_PHONE=+1000000000

# ===== TUY CHON =====
# Danh sach origin FE, phan tach bang dau phay. Production: https://your-frontend.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Port do PaaS inject (Render/Railway/Heroku). Mac dinh 8080 neu khong co.
# PORT=8080

# Bat log SQL (chi nen bat khi debug)
JPA_SHOW_SQL=false

# Chi bat khi can baseline DB cu (xem README)
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_BASELINE_VERSION=1
